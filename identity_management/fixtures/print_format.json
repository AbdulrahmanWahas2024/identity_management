  "html": "<div class=\"print-format\" style=\"direction: rtl; font-family: 'Cairo', Tahoma, sans-serif; padding: 20px; max-width: 210mm; margin: auto; background: #fff; border: 1px solid #d1d8dd;\">\r\n    \r\n    <!-- Header Section -->\r\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\r\n        <tr>\r\n            <!-- Photo Box (4x6 cm representation) -->\r\n            <td style=\"width: 25%; vertical-align: top;\">\r\n                <div style=\"border: 2px solid #1b365d; width: 120px; height: 160px; text-align: center; padding: 5px; background: #f8f9fa;\">\r\n                    {% if doc.employee_photo %}\r\n                        <img src=\"{{ doc.employee_photo }}\" style=\"width: 100%; height: 130px; object-fit: cover;\" />\r\n                    {% else %}\r\n                        <div style=\"height: 130px; display: flex; align-items: center; justify-content: center; color: #7f8c8d; font-size: 12px;\">\r\n                            الصورة الشخصية<br>4 × 6 سم\r\n                        </div>\r\n                    {% endif %}\r\n                </div>\r\n            </td>\r\n            \r\n            <!-- Title & Company Info -->\r\n            <td style=\"width: 45%; vertical-align: top; text-align: center;\">\r\n                <h3 style=\"margin: 0; color: #1b365d; font-size: 16px;\">شركة النفط الوطنية</h3>\r\n                <h4 style=\"margin: 10px 0; color: #2c3e50; font-size: 18px; border-bottom: 2px solid #1b365d; padding-bottom: 5px; display: inline-block;\">\r\n                    استمارة طلب إصدار بطاقة موظف\r\n                </h4>\r\n            </td>\r\n            \r\n            <!-- Request Meta Data -->\r\n            <td style=\"width: 30%; vertical-align: top;\">\r\n                <table style=\"width: 100%; font-size: 12px; background: #f1f4f8; padding: 8px; border-radius: 4px;\">\r\n                    <tr>\r\n                        <td style=\"font-weight: bold; padding: 3px;\">رقم الطلب:</td>\r\n                        <td style=\"padding: 3px;\">{{ doc.name }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td style=\"font-weight: bold; padding: 3px;\">تاريخ الطلب:</td>\r\n                        <td style=\"padding: 3px;\">{{ doc.request_date }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td style=\"font-weight: bold; padding: 3px;\">الوقت:</td>\r\n                        <td style=\"padding: 3px;\">{{ doc.request_time or '' }}</td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- Section 1: Employee Data -->\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <div style=\"background: #1b365d; color: #fff; padding: 6px 12px; font-weight: bold; font-size: 13px; border-radius: 4px 4px 0 0;\">\r\n            1. بيانات الموظف\r\n        </div>\r\n        <table style=\"width: 100%; border-collapse: collapse; border: 1px solid #1b365d; font-size: 13px;\">\r\n            <tr>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; width: 15%; background: #f9f9f9; font-weight: bold;\">الاسم الكامل:</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; width: 35%;\">{{ doc.employee_name or '' }}</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; width: 15%; background: #f9f9f9; font-weight: bold;\">الرقم الوظيفي:</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; width: 35%;\">{{ doc.employee_id or '' }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; background: #f9f9f9; font-weight: bold;\">القسم / الإدارة:</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ doc.department or '' }}</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; background: #f9f9f9; font-weight: bold;\">الجنسية:</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ doc.nationality or '' }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; background: #f9f9f9; font-weight: bold;\">تاريخ الميلاد:</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ doc.date_of_birth or '' }}</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; background: #f9f9f9; font-weight: bold;\">البريد الإلكتروني:</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ doc.email or '' }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Section 2: Request Data -->\r\n    <div style=\"margin-bottom: 20px;\">\r\n        <div style=\"background: #1b365d; color: #fff; padding: 6px 12px; font-weight: bold; font-size: 13px; border-radius: 4px 4px 0 0;\">\r\n            2. بيانات الطلب\r\n        </div>\r\n        <table style=\"width: 100%; border-collapse: collapse; border: 1px solid #1b365d; font-size: 13px;\">\r\n            <tr>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; width: 15%; background: #f9f9f9; font-weight: bold;\">نوع الطلب:</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; colspan: 3;\" colspan=\"3\">\r\n                    <span style=\"margin-left: 20px;\">[{{ 'x' if doc.request_type == 'إصدار جديد' else ' ' }}] إصدار جديد</span>\r\n                    <span style=\"margin-left: 20px;\">[{{ 'x' if doc.request_type == 'تجديد' else ' ' }}] تجديد</span>\r\n                    <span>[{{ 'x' if doc.request_type == 'بدل فاقد' else ' ' }}] بدل فاقد</span>\r\n                </td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; background: #f9f9f9; font-weight: bold;\">سبب الطلب:</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd;\" colspan=\"3\">{{ doc.request_reason or '' }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; background: #f9f9f9; font-weight: bold;\">مكان العمل:</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ doc.work_location or '' }}</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; background: #f9f9f9; font-weight: bold;\">تاريخ المباشرة:</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd;\">{{ doc.commencement_date or '' }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd; background: #f9f9f9; font-weight: bold;\">ملاحظات:</td>\r\n                <td style=\"padding: 8px; border: 1px solid #ddd;\" colspan=\"3\">{{ doc.notes or '' }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- Section 3: Required Attachments -->\r\n    <div style=\"margin-bottom: 30px;\">\r\n        <div style=\"background: #1b365d; color: #fff; padding: 6px 12px; font-weight: bold; font-size: 13px; border-radius: 4px 4px 0 0;\">\r\n            3. المرفقات المطلوبة\r\n        </div>\r\n        <div style=\"border: 1px solid #1b365d; border-top: none; padding: 10px; font-size: 13px; display: flex; justify-content: space-around;\">\r\n            <span>[ {{ '✓' if doc.attach_personal_photo else ' ' }} ] صورة شخصية</span>\r\n            <span>[ {{ '✓' if doc.attach_id_iqama else ' ' }} ] صورة الهوية / الإقامة</span>\r\n            <span>[ {{ '✓' if doc.manager_approval else ' ' }} ] موافقة المدير المباشر</span>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Signatures Section (Footer layout) -->\r\n    <table style=\"width: 100%; margin-top: 40px; font-size: 13px;\">\r\n        <tr>\r\n            <!-- Leave Officer / Personnel Affairs (Right) -->\r\n            <td style=\"width: 50%; text-align: center; vertical-align: top;\">\r\n                <div style=\"font-weight: bold; margin-bottom: 5px;\">مختص شؤون الموظفين / الإجازات</div>\r\n                <div style=\"color: #555; margin-bottom: 30px;\">الاسم: {{ doc.leave_officer or '........................................' }}</div>\r\n                <div style=\"border-top: 1px dashed #7f8c8d; width: 60%; margin: auto; padding-top: 5px;\">التوقيع والختم</div>\r\n            </td>\r\n            \r\n            <!-- HR Manager (Shifted slightly to the left as requested) -->\r\n            <td style=\"width: 50%; text-align: center; vertical-align: top; padding-left: 30px;\">\r\n                <div style=\"font-weight: bold; margin-bottom: 5px;\">مدير الموارد البشرية</div>\r\n                <div style=\"color: #555; margin-bottom: 30px;\">الاسم: {{ doc.hr_manager or '........................................' }}</div>\r\n                <div style=\"border-top: 1px dashed #7f8c8d; width: 60%; margin: auto; padding-top: 5px;\">التوقيع والاعتماد</div>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n</div>",
