  "prepared_report": 0,
  "query": "SELECT\r\n    cr.name AS \"رقم الطلب:Link/Card Request:150\",\r\n    cr.employee_name AS \"اسم الموظف:Data:220\",\r\n    cr.employee_number AS \"الرقم الوظيفي:Data:120\",\r\n    cr.request_date AS \"تاريخ الطلب:Date:120\",\r\n    cr.request_type AS \"نوع الطلب:Link/Card Request Type:150\",\r\n    cr.request_source AS \"جهة الطلب:Data:150\",\r\n    cr.department AS \"الدائرة:Link/Department:180\",\r\n    cr.branch AS \"الفرع:Link/Branch:180\",\r\n    cr.workflow_state AS \"حالة الطلب:Data:160\"\r\n\r\nFROM `tabCard Request` cr\r\n\r\nWHERE\r\n    cr.request_date BETWEEN %(from_date)s AND %(to_date)s\r\n\r\nORDER BY\r\n    cr.request_date DESC,\r\n    cr.creation DESC",
